# Copy to .env for local development. Never commit .env.
# On Vercel, set the runtime variables in Project Settings > Environment Variables.

# Deployment label returned by /v1/health: local, preview or production.
ENVIRONMENT=local

# Exact browser origins allowed by CORS, comma-separated. No wildcard.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Runtime database: Supabase transaction pooler (port 6543), restricted runtime role.
# Plain postgresql:// is converted to postgresql+psycopg:// and sslmode=require is added
# unless an sslmode is given. Leave commented out to run without a database.
# DATABASE_URL=postgresql://piele_api.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Supabase project URL and the JWT audience of member access tokens. Tokens are verified
# against the project's JWKS endpoint; set SUPABASE_JWT_SECRET only for a project still on
# the legacy shared secret (HS256).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_SECRET=

# Server-only Storage credential for evidence upload grants and playback URLs, and the
# private bucket that holds the videos. Never expose the service role key to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evidence
# EVIDENCE_MAX_BYTES=52428800
# EVIDENCE_UPLOAD_TTL_SECONDS=7200
# EVIDENCE_PLAYBACK_TTL_SECONDS=600

# Match centre providers (public feeds, no keys).
# URC_GRAPHQL_URL=https://www.unitedrugby.com/graphql
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# ESPN_SCOREBOARD_URL=https://site.api.espn.com/apis/site/v2/sports/rugby/270557/scoreboard
# EXTERNAL_TIMEOUT_SECONDS=6
