# Copy to .env for local development. Never commit .env.
# On Vercel, set the runtime variables in Project Settings > Environment Variables.

# Deployment label returned by /v1/health: local, preview or production.
ENVIRONMENT=local

# Exact browser origins allowed by CORS, comma-separated. No wildcard.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Runtime database: Supabase transaction pooler (port 6543), restricted runtime role.
# Plain postgresql:// is converted to postgresql+psycopg:// and sslmode=require is added
# unless an sslmode is given. Leave commented out to run without a database.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

# Migrations only (Alembic): Supabase session pooler (port 5432) or direct connection.
# Never the transaction pooler. Not needed by the deployed API.
# MIGRATION_DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase project URL and the JWT audience the API will verify (auth is not built yet).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
