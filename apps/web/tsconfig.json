{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/button": ["./src/app/shared/ui/button/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/app/shared/ui/input/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./src/app/shared/ui/textarea/src/index.ts"],
      "@spartan-ng/helm/label": ["./src/app/shared/ui/label/src/index.ts"],
      "@spartan-ng/helm/checkbox": ["./src/app/shared/ui/checkbox/src/index.ts"],
      "@spartan-ng/helm/radio-group": ["./src/app/shared/ui/radio-group/src/index.ts"],
      "@spartan-ng/helm/dialog": ["./src/app/shared/ui/dialog/src/index.ts"],
      "@spartan-ng/helm/collapsible": ["./src/app/shared/ui/collapsible/src/index.ts"],
      "@spartan-ng/helm/toggle-group": ["./src/app/shared/ui/toggle-group/src/index.ts"],
      "@spartan-ng/helm/toggle": ["./src/app/shared/ui/toggle/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/app/shared/ui/utils/src/index.ts"],
      "@spartan-ng/helm/switch": ["./src/app/shared/ui/switch/src/index.ts"],
      "@spartan-ng/helm/slider": ["./src/app/shared/ui/slider/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
