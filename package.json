{
  "name": "pavilion",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "npm --prefix apps/web start -- --host 127.0.0.1",
    "build": "npm --prefix apps/web run build",
    "test": "npm --prefix apps/web test -- --watch=false",
    "test:e2e": "npm --prefix apps/web run test:e2e",
    "setup": "npm --prefix apps/web ci",
    "api": "uv --directory apps/api run uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "test:api": "uv --directory apps/api run pytest",
    "setup:api": "uv --directory apps/api sync",
    "smoke": "node scripts/smoke-deployment.mjs",
    "setup:agent": "npm --prefix apps/agent ci",
    "test:agent": "npm --prefix apps/agent test"
  }
}
